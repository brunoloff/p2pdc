cmake_minimum_required(VERSION 3.20)
if(CASE STREQUAL "browser" OR CASE STREQUAL "browser_override")
    set(EMSCRIPTEN ON)
elseif(NOT CASE STREQUAL "native" AND NOT CASE STREQUAL "overrides")
    message(FATAL_ERROR "unknown options test case")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/NativeOptions.cmake")
if(CASE STREQUAL "browser" AND BUILD_TESTING)
    message(FATAL_ERROR "browser build unexpectedly enables native test suite")
endif()
if(CASE STREQUAL "browser_override" AND NOT BUILD_TESTING)
    message(FATAL_ERROR "browser test override was not preserved")
endif()
if(CASE STREQUAL "native")
    if(NOT P2PDC_ENABLE_OPENDHT OR NOT P2PDC_ENABLE_NATIVE_TRANSPORT)
        message(FATAL_ERROR "native public API backends are not enabled by default")
    endif()
else()
    if(P2PDC_ENABLE_OPENDHT OR P2PDC_ENABLE_NATIVE_TRANSPORT)
        message(FATAL_ERROR "native backends ignored browser defaults or explicit overrides")
    endif()
endif()
