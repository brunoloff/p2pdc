{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${fileDir}/build/${presetName}"
    },
    {
      "name": "deps",
      "displayName": "Dependencies for Linux",
      "inherits": "base",
      "cacheVariables": {
        "P2PDC_BUILD_DEPENDENCIES": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${fileDir}/build/prefix-linux"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux library and tests",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "${fileDir}/build/prefix-linux",
        "BUILD_TESTING": "ON",
        "P2PDC_BUILD_SHARED_TEXT": "OFF",
        "P2PDC_TEST_OPENDHT": "ON",
        "P2PDC_TEST_NATIVE_TRANSPORT": "ON"
      }
    },
    {
      "name": "deps-macos",
      "displayName": "Dependencies for macOS 13 and later",
      "inherits": "base",
      "cacheVariables": {
        "P2PDC_BUILD_DEPENDENCIES": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_INSTALL_PREFIX": "${fileDir}/build/prefix-macos"
      }
    },
    {
      "name": "macos",
      "displayName": "macOS library and tests",
      "description": "Only the dependencies' folder counts, not Homebrew; pass GTest_DIR for GoogleTest.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "CMAKE_IGNORE_PREFIX_PATH": "/opt/homebrew;/usr/local",
        "CMAKE_PREFIX_PATH": "${fileDir}/build/prefix-macos",
        "BUILD_TESTING": "ON",
        "P2PDC_BUILD_SHARED_TEXT": "OFF",
        "P2PDC_TEST_OPENDHT": "ON",
        "P2PDC_TEST_NATIVE_TRANSPORT": "ON"
      }
    },
    {
      "name": "deps-windows",
      "displayName": "Dependencies for Windows (in an MSYS2 UCRT64 shell)",
      "inherits": "base",
      "cacheVariables": {
        "P2PDC_BUILD_DEPENDENCIES": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${fileDir}/build/prefix-windows"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows library and tests (in an MSYS2 UCRT64 shell)",
      "description": "MSYS2 ships the newest GCC, whose new warnings are often false alarms; Linux CI keeps warnings as errors.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_PREFIX_PATH": "${fileDir}/build/prefix-windows",
        "P2PDC_WERROR": "OFF",
        "BUILD_TESTING": "ON",
        "P2PDC_BUILD_SHARED_TEXT": "OFF",
        "P2PDC_TEST_OPENDHT": "ON",
        "P2PDC_TEST_NATIVE_TRANSPORT": "ON"
      }
    },
    {
      "name": "emscripten",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake"
    },
    {
      "name": "deps-web",
      "displayName": "Dependencies for browsers",
      "inherits": "emscripten",
      "cacheVariables": {
        "P2PDC_BUILD_DEPENDENCIES": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${fileDir}/build/prefix-web"
      }
    },
    {
      "name": "web",
      "displayName": "Browser library",
      "inherits": "emscripten",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "P2PDC_BUILD_SHARED_TEXT": "OFF",
        "P2PDC_BUILD_BROWSER_SECURITY_TEST": "ON",
        "SODIUM_INCLUDE_DIR": "${fileDir}/build/prefix-web/include",
        "SODIUM_LIBRARY": "${fileDir}/build/prefix-web/lib/libsodium.a"
      }
    }
  ],
  "buildPresets": [
    { "name": "deps", "configurePreset": "deps" },
    { "name": "linux", "configurePreset": "linux" },
    { "name": "deps-macos", "configurePreset": "deps-macos" },
    { "name": "macos", "configurePreset": "macos" },
    { "name": "deps-windows", "configurePreset": "deps-windows" },
    { "name": "windows", "configurePreset": "windows" },
    { "name": "deps-web", "configurePreset": "deps-web" },
    { "name": "web", "configurePreset": "web" }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    },
    {
      "name": "macos",
      "configurePreset": "macos",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "output": { "outputOnFailure": true },
      "execution": { "timeout": 300 }
    }
  ],
  "workflowPresets": [
    {
      "name": "deps",
      "steps": [
        { "type": "configure", "name": "deps" },
        { "type": "build", "name": "deps" }
      ]
    },
    {
      "name": "linux",
      "steps": [
        { "type": "configure", "name": "linux" },
        { "type": "build", "name": "linux" },
        { "type": "test", "name": "linux" }
      ]
    },
    {
      "name": "deps-macos",
      "steps": [
        { "type": "configure", "name": "deps-macos" },
        { "type": "build", "name": "deps-macos" }
      ]
    },
    {
      "name": "deps-windows",
      "steps": [
        { "type": "configure", "name": "deps-windows" },
        { "type": "build", "name": "deps-windows" }
      ]
    },
    {
      "name": "deps-web",
      "steps": [
        { "type": "configure", "name": "deps-web" },
        { "type": "build", "name": "deps-web" }
      ]
    },
    {
      "name": "web",
      "steps": [
        { "type": "configure", "name": "web" },
        { "type": "build", "name": "web" }
      ]
    }
  ]
}
