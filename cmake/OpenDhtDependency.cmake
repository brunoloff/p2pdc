# A supplied target may come from a toolchain or a parent application.
if(NOT DEFINED P2PDC_OPENDHT_TARGET)
    set(P2PDC_OPENDHT_TARGET "" CACHE STRING "Existing CMake target providing OpenDHT")
endif()
if(P2PDC_OPENDHT_TARGET)
    if(NOT TARGET "${P2PDC_OPENDHT_TARGET}")
        message(FATAL_ERROR "P2PDC_OPENDHT_TARGET does not name an existing target: ${P2PDC_OPENDHT_TARGET}")
    endif()
    set(p2pdc_opendht_target "${P2PDC_OPENDHT_TARGET}")
else()
    find_package(PkgConfig REQUIRED)
    pkg_check_modules(OPENDHT REQUIRED IMPORTED_TARGET opendht)
    set(p2pdc_opendht_target PkgConfig::OPENDHT)
endif()
if(NOT TARGET msgpack-cxx)
    find_package(msgpack-cxx CONFIG REQUIRED)
endif()
