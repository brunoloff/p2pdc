 namespace {
 
+#if USE_NICE && defined(__linux__) && !defined(__ANDROID__)
+bool p2pdcNiceTlsSupported() noexcept {
+	Dl_info backend{};
+	if (!dladdr(reinterpret_cast<void *>(&nice_agent_set_relay_info), &backend) ||
+	    !backend.dli_fname)
+		return false;
+	void *handle = dlopen(backend.dli_fname, RTLD_NOW | RTLD_NOLOAD);
+	if (!handle)
+		return false;
+	void *symbol = dlsym(handle, "nice_p2pdc_tls_supported");
+	Dl_info provider{};
+	const bool sameLibrary = symbol && dladdr(symbol, &provider) &&
+	                         provider.dli_fbase == backend.dli_fbase;
+	const bool supported = sameLibrary && reinterpret_cast<unsigned int (*)()>(symbol)() == 1;
+	dlclose(handle);
+	return supported;
+}
+#endif
