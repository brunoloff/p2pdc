+unsigned int P2pdcBackendFeatures() noexcept {
+#if USE_NICE
+#if defined(NICE_VERSION_MAJOR) && \
+    (NICE_VERSION_MAJOR > 0 || NICE_VERSION_MINOR > 1 || \
+     (NICE_VERSION_MINOR == 1 && NICE_VERSION_MICRO >= 24))
+	unsigned int features = 7;
+#else
+	// An old-header build can load the incompatible 0.1.24 runtime later.
+	unsigned int features = 3;
+#endif
+#if defined(__linux__) && !defined(__ANDROID__)
+	if (p2pdcNiceTlsSupported())
+		features |= 8;
+#endif
+	return features;
+#else
+	return 5;
+#endif
+}
