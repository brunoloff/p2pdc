diff --git a/socket/tls.c b/socket/tls.c
new file mode 100644
index 0000000..fc4879e
--- /dev/null
+++ b/socket/tls.c
@@ -0,0 +1,328 @@
+#ifdef HAVE_CONFIG_H
+#include "config.h"
+#endif
+
+#include "tls.h"
+#include "socket-priv.h"
+#include "agent-priv.h"
+
+#include <openssl/ssl.h>
+#include <openssl/x509v3.h>
+
+#define TLS_QUEUE_LIMIT (1024 * 1024)
+#define TLS_QUEUE_RECORDS 128
+
+typedef struct {
+  NiceSocket *base;
+  NiceAddress server;
+  SSL_CTX *context;
+  SSL *ssl;
+  GQueue pending;
+  gsize pending_bytes;
+  gboolean ready;
+  gboolean failed;
+} TlsSocket;
+
+static gint tls_recv (NiceSocket *, NiceInputMessage *, guint, NiceMessageExtraData *);
+static gint tls_send (NiceSocket *, const NiceAddress *, const NiceOutputMessage *, guint);
+static gint tls_send_reliable (NiceSocket *, const NiceAddress *, const NiceOutputMessage *, guint);
+static gboolean tls_reliable (NiceSocket *);
+static gboolean tls_can_send (NiceSocket *, NiceAddress *);
+static void tls_writable (NiceSocket *, NiceSocketWritableCb, gpointer);
+static gboolean tls_based_on (NiceSocket *, NiceSocket *);
+static void tls_close (NiceSocket *);
+
+static gboolean
+flush_ciphertext (TlsSocket *tls)
+{
+  gchar buffer[16384];
+  BIO *output = SSL_get_wbio (tls->ssl);
+  while (BIO_ctrl_pending (output)) {
+    int count = BIO_read (output, buffer, sizeof (buffer));
+    gssize sent = count <= 0 ? -1 : nice_socket_send_reliable (tls->base, NULL, count, buffer);
+    if (sent != count)
+      return FALSE;
+  }
+  return TRUE;
+}
+
+static gboolean
+handshake (NiceSocket *socket)
+{
+  TlsSocket *tls = socket->priv;
+  int result = SSL_do_handshake (tls->ssl);
+  int error = result == 1 ? SSL_ERROR_NONE : SSL_get_error (tls->ssl, result);
+  gboolean flushed = flush_ciphertext (tls);
+  if (!flushed || (result != 1 && error != SSL_ERROR_WANT_READ))
+    return FALSE;
+  if (result == 1 && !tls->ready) {
+    if (SSL_get_verify_result (tls->ssl) != X509_V_OK)
+      return FALSE;
+    tls->ready = TRUE;
+    nice_socket_flush_send_queue (socket, &tls->pending);
+    tls->pending_bytes = 0;
+    if (tls->failed)
+      return FALSE;
+  }
+  return TRUE;
+}
+
+static gboolean
+set_identity (SSL *ssl, const gchar *hostname)
+{
+  GInetAddress *ip = g_inet_address_new_from_string (hostname);
+  gboolean result;
+  if (ip) {
+    result = X509_VERIFY_PARAM_set1_ip_asc (SSL_get0_param (ssl), hostname) == 1;
+    g_object_unref (ip);
+    return result;
+  }
+  return SSL_set_tlsext_host_name (ssl, hostname) == 1 && SSL_set1_host (ssl, hostname) == 1;
+}
+
+static gboolean
+initialize_tls (TlsSocket *tls, const gchar *hostname)
+{
+  BIO *input, *output;
+  tls->context = SSL_CTX_new (TLS_client_method ());
+  if (!tls->context || SSL_CTX_set_min_proto_version (tls->context, TLS1_2_VERSION) != 1 ||
+      SSL_CTX_set_default_verify_paths (tls->context) != 1)
+    return FALSE;
+  SSL_CTX_set_options (tls->context, SSL_OP_NO_RENEGOTIATION);
+  SSL_CTX_set_verify (tls->context, SSL_VERIFY_PEER, NULL);
+  tls->ssl = SSL_new (tls->context);
+  if (!tls->ssl || !set_identity (tls->ssl, hostname))
+    return FALSE;
+  input = BIO_new (BIO_s_mem ());
+  output = BIO_new (BIO_s_mem ());
+  if (!input || !output) {
+    BIO_free (input);
+    BIO_free (output);
+    return FALSE;
+  }
+  BIO_set_mem_eof_return (input, -1);
+  SSL_set_bio (tls->ssl, input, output);
+  SSL_set_connect_state (tls->ssl);
+  return TRUE;
+}
+
+NiceSocket *
+nice_tls_socket_new (NiceSocket *base, const NiceAddress *server, const gchar *hostname)
+{
+  NiceSocket *socket = g_slice_new0 (NiceSocket);
+  TlsSocket *tls = g_slice_new0 (TlsSocket);
+  socket->priv = tls;
+  tls->base = base;
+  tls->server = *server;
+  socket->type = NICE_SOCKET_TYPE_TLS;
+  socket->fileno = base->fileno;
+  socket->addr = base->addr;
+  socket->recv_messages = tls_recv;
+  socket->send_messages = tls_send;
+  socket->send_messages_reliable = tls_send_reliable;
+  socket->is_reliable = tls_reliable;
+  socket->can_send = tls_can_send;
+  socket->set_writable_callback = tls_writable;
+  socket->is_based_on = tls_based_on;
+  socket->close = tls_close;
+  if (!hostname || !*hostname || !initialize_tls (tls, hostname) || !handshake (socket)) {
+    nice_socket_free (socket);
+    return NULL;
+  }
+  return socket;
+}
+
+static gboolean
+read_ciphertext (TlsSocket *tls)
+{
+  gchar buffer[16384];
+  gssize count = nice_socket_recv (tls->base, NULL, sizeof (buffer), buffer);
+  if (count < 0)
+    tls->failed = TRUE;
+  if (count <= 0)
+    return FALSE;
+  if (BIO_write (SSL_get_rbio (tls->ssl), buffer, count) != count) {
+    tls->failed = TRUE;
+    return FALSE;
+  }
+  return TRUE;
+}
+
+static int
+read_plaintext (TlsSocket *tls, void *buffer, gsize size)
+{
+  int count = SSL_read (tls->ssl, buffer, MIN (size, G_MAXINT));
+  int error = count > 0 ? SSL_ERROR_NONE : SSL_get_error (tls->ssl, count);
+  if (!flush_ciphertext (tls)) {
+    tls->failed = TRUE;
+    return count > 0 ? count : -1;
+  }
+  if (count > 0)
+    return count;
+  return error == SSL_ERROR_WANT_READ ? 0 : -1;
+}
+
+static gint
+read_message (NiceSocket *socket, NiceInputMessage *message)
+{
+  TlsSocket *tls = socket->priv;
+  gint index;
+  message->length = 0;
+  for (index = 0; index < message->n_buffers ||
+       (message->n_buffers == -1 && message->buffers[index].buffer); ++index) {
+    GInputVector *vector = &message->buffers[index];
+    gsize offset = 0;
+    while (offset < vector->size) {
+      int count = 0;
+      if (!tls->ready && !handshake (socket))
+        return -1;
+      if (tls->ready)
+        count = read_plaintext (tls, (guint8 *) vector->buffer + offset, vector->size - offset);
+      if (count < 0) {
+        tls->failed = TRUE;
+        if (message->length)
+          goto done;
+        return -1;
+      }
+      if (count > 0) {
+        offset += count;
+        message->length += count;
+        if (tls->failed)
+          goto done;
+        continue;
+      }
+      if (!read_ciphertext (tls)) {
+        if (tls->failed && !message->length)
+          return -1;
+        goto done;
+      }
+    }
+  }
+done:
+  if (message->length && message->from)
+    *message->from = tls->server;
+  return message->length ? 1 : 0;
+}
+
+static gint
+tls_recv (NiceSocket *socket, NiceInputMessage *messages, guint count, NiceMessageExtraData *extra)
+{
+  TlsSocket *tls = socket->priv;
+  guint i;
+  (void) extra;
+  if (tls->failed)
+    return -1;
+  for (i = 0; i < count; ++i) {
+    int result = read_message (socket, &messages[i]);
+    if (result < 0)
+      tls->failed = TRUE;
+    if (result <= 0)
+      return i ? (gint) i : result;
+    if (tls->failed)
+      return i + 1;
+  }
+  return count;
+}
+
+static gboolean
+write_message (TlsSocket *tls, const NiceOutputMessage *message)
+{
+  gint i;
+  for (i = 0; i < message->n_buffers ||
+       (message->n_buffers == -1 && message->buffers[i].buffer); ++i) {
+    const GOutputVector *vector = &message->buffers[i];
+    if (vector->size && (vector->size > G_MAXINT ||
+        SSL_write (tls->ssl, vector->buffer, vector->size) != (int) vector->size))
+      return FALSE;
+  }
+  return flush_ciphertext (tls);
+}
+
+static gint
+tls_send (NiceSocket *socket, const NiceAddress *to, const NiceOutputMessage *messages, guint count)
+{
+  TlsSocket *tls = socket->priv;
+  guint i;
+  if (tls->failed)
+    return -1;
+  if (!tls->ready || !nice_socket_can_send (tls->base, (NiceAddress *) to))
+    return 0;
+  for (i = 0; i < count; ++i) {
+    if (!write_message (tls, &messages[i])) {
+      tls->failed = TRUE;
+      return i ? (gint) i : -1;
+    }
+  }
+  return count;
+}
+
+static gint
+tls_send_reliable (NiceSocket *socket, const NiceAddress *to,
+    const NiceOutputMessage *messages, guint count)
+{
+  TlsSocket *tls = socket->priv;
+  guint i;
+  if (tls->failed)
+    return -1;
+  if (!tls->ready) {
+    gsize bytes = tls->pending_bytes;
+    if (count > TLS_QUEUE_RECORDS - g_queue_get_length (&tls->pending))
+      return -1;
+    for (i = 0; i < count; ++i) {
+      gsize size = output_message_get_size (&messages[i]);
+      if (size > TLS_QUEUE_LIMIT - bytes)
+        return -1;
+      bytes += size;
+    }
+    for (i = 0; i < count; ++i)
+      nice_socket_queue_send (&tls->pending, to, &messages[i], 1);
+    tls->pending_bytes = bytes;
+    return count;
+  }
+  for (i = 0; i < count; ++i)
+    if (!write_message (tls, &messages[i])) {
+      tls->failed = TRUE;
+      return -1;
+    }
+  return count;
+}
+
+static gboolean
+tls_reliable (NiceSocket *socket)
+{
+  TlsSocket *tls = socket->priv;
+  return nice_socket_is_reliable (tls->base);
+}
+
+static gboolean
+tls_can_send (NiceSocket *socket, NiceAddress *address)
+{
+  TlsSocket *tls = socket->priv;
+  return tls->ready && !tls->failed && nice_socket_can_send (tls->base, address);
+}
+
+static void
+tls_writable (NiceSocket *socket, NiceSocketWritableCb callback, gpointer data)
+{
+  TlsSocket *tls = socket->priv;
+  nice_socket_set_writable_callback (tls->base, callback, data);
+}
+
+static gboolean
+tls_based_on (NiceSocket *socket, NiceSocket *other)
+{
+  TlsSocket *tls = socket->priv;
+  return socket == other || nice_socket_is_based_on (tls->base, other);
+}
+
+static void
+tls_close (NiceSocket *socket)
+{
+  TlsSocket *tls = socket->priv;
+  nice_socket_free_send_queue (&tls->pending);
+  SSL_free (tls->ssl);
+  SSL_CTX_free (tls->context);
+  nice_socket_free (tls->base);
+  g_slice_free (TlsSocket, tls);
+  socket->priv = NULL;
+}
